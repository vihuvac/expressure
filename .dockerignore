# Ignore everything by default
*

# Whitelist application code
!package*.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!@types/
!src/
!config/

# Whitelist development tools
!.eslintrc
!eslint.config.*
!jest.config.*
!jest.setup.*
!nodemon.json
!.prettierrc*
!.jsdoc*
!.lintstagedrc

# Whitelist additional development files that might be needed
!.husky/
!sonar-project.properties
